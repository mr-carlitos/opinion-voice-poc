# Keep real deployment outputs and application identifiers in ignored .env only.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=opinion-voice
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-5.1
# Provisioning defaults: GPT-5.1 2025-11-13, regional Standard, capacity 100.
# GlobalStandard is rejected; DataZoneStandard requires explicit selection.
VOICELIVE_ENDPOINT=
VOICELIVE_API_VERSION=2026-04-10
VOICE_NAME=de-DE-KatjaNeural
# Explicit demo tradeoff: streaming speaks before independent evidence validation.
# Strict remains default; final summary review/approval is required in both modes.
VOICE_DELIVERY_MODE=strict
# Native stock avatar is session opt-in and requires streaming. Default stays audio-only.
VOICE_AVATAR_ENABLED=false
# Default: single-tenant public client; delegated User.Read + Files.ReadWrite.
# Azure CLI login and application device sign-in are separate; tokens stay in memory.
# Delegated mode needs no client secret. Never store access tokens.
AZURE_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_AUTH_MODE=delegated
# Optional application mode: explicit operator approval and existing site grants.
# The ignored credential file must contain GRAPH_TENANT_ID, GRAPH_APP_CLIENT_ID
# and GRAPH_APP_CLIENT_SECRET. Only these settings are used; never commit values.
# Application access is not restricted by each participant's SharePoint rights.
GRAPH_APPLICATION_CREDENTIALS_FILE=
# Use an approved HTTPS commercial SharePoint folder sharing link for initial
# Graph /shares resolution, without automatic redemption or access grants.
# OR use a canonical folder URL WITH both corresponding drive and folder IDs.
# Direct URLs alone are unsupported (no site discovery). Graph must validate
# pinned IDs before use; never derive or guess IDs from a sharing-link token.
# Real sharing-link URLs belong only in ignored .env, never docs/state/screenshots.
SHAREPOINT_INPUT_FOLDER_URL=
SHAREPOINT_INPUT_DRIVE_ID=
SHAREPOINT_INPUT_FOLDER_ID=
SHAREPOINT_OUTPUT_FOLDER_URL=
SHAREPOINT_OUTPUT_DRIVE_ID=
SHAREPOINT_OUTPUT_FOLDER_ID=
# Resolved input/output folders must not overlap. Files.ReadWrite is not an ACL
# boundary around these two folders; use an approved synthetic test identity.
AVATAR_ENABLED=false